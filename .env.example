NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://carebridge:carebridge@localhost:5432/carebridge

JWT_ACCESS_SECRET=replace-me-32-char-minimum
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Service-to-service keys (rotate regularly, different key per service)
SERVICE_KEY_ML=replace-me-ml-service-key
SERVICE_KEY_REALTIME=replace-me-realtime-service-key

# SMS provider for OTP (e.g. Twilio) — used by auth controller
SMS_PROVIDER_API_KEY=replace-me
